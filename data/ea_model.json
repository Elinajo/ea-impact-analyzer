  "_relationship_semantics": {
    "SUPPORTS": "application -> capability. The application realises part of the capability.",
    "OWNS": "application -> data_object. The application is the authoritative source for that data. Retiring it orphans the data object.",
    "CONSUMES": "application -> data_object. The application reads the data but is not authoritative for it. Retiring the consumer does NOT affect the data object.",
    "DEPENDS_ON": "application -> application. The source application requires a service or interface provided by the target. Retiring the target breaks the source.",
    "RUNS_ON": "application -> technology. Retiring the last application on a technology leaves that technology orphaned."
  },

