# Copy this file to .env and fill in the key:
#
#     cp .env.example .env
#
# .env is git-ignored. src/llm.py reads it into os.environ at startup without
# overwriting anything already exported, so an exported key always wins.
# The key is never written into source or committed.

ANTHROPIC_API_KEY=sk-ant-...

# Only needed if the key above is identity-linked. Such a key is rejected with
# a 400 ("anthropic-workspace-id is required") until every request names the
# workspace it acts in. A personal API key does not need this — leave it out.
#
# Find the id at https://console.anthropic.com/settings/workspaces: open the
# workspace and take the id from the page URL.
#
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
